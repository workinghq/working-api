{
  "name": "working-api",
  "version": "0.1.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "pretest:e2e": "dotenv run -f .env.test -- prisma migrate deploy",
    "test:e2e": "dotenv run -f .env.test -- vitest run --config ./vitest.config.e2e.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "oxlint --type-aware",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nestjs/authentication": "^0.1.5",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "nestjs-pino": "^5.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.16",
    "@nestjs/testing": "12.6.0",
    "@types/node": "26.6.7",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.1",
    "dotenv": "18.0.10",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "source-map-support": "0.5.21",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
