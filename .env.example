# Runtime environment: development, test or production.
NODE_ENV=development

# Port on witch the server listens
PORT=3000

# Minimum log level: trace, debug, info, warn, error or fatal.
LOG_LEVEL=info

# Database connection string used by the application to connect to the database
DATABASE_URL=

# Postgres variables for docker compose
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=working