{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],

  "labels": ["dependencies"],
  "baseBranchPatterns": ["develop"],

  "prConcurrentLimit": 5,

  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "matchCurrentVersion": "!/^0\\./",
      "groupName": "patch and minor dependencies"
    }
  ]
}
